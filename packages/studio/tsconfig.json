{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "composite": false,
    "incremental": true,
    "emitDeclarationOnly": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["src/**/*", "vite.config.ts", "tsup.config.ts", "yaml.d.ts"],
  "exclude": ["dist", "node_modules"]
}
