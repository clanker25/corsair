{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node", "jest"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "incremental": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/*.test.ts"],
  "references": []
}
